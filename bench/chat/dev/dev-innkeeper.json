 "memories": {
  "m001": {
   "text": "主人收养了一条村里的土狗，名叫土豆，白天总趴在客栈门口晒太阳",
   "date": "2025-01-13",
   "cluster": "c01",
   "role": "fact"
  },
  "m002": {
   "text": "主人每天早上用手冲壶煮一杯咖啡，豆子是邻村的咖啡农送的",
   "date": "2025-02-08",
   "cluster": "c02",
   "role": "fact"
  },
  "m003": {
   "text": "主人三年前辞掉了深圳一家设计公司的工作，来到了这个山村",
   "date": "2025-02-10",
   "cluster": null,
   "role": "filler"
  },
  "m004": {
   "text": "主人上山捡的一篮菌子，被住客嚷着要炒了当晚饭",
   "date": "2025-03-15",
   "cluster": "c03",
   "role": "episode"
  },
  "m005": {
   "text": "主人的客栈叫山月，一共只有六间客房，推窗能看见远处的山",
   "date": "2025-04-01",
   "cluster": null,
   "role": "filler"
  },
  "m006": {
   "text": "客栈的房东是隔壁的杨阿婆，七十多岁，每天早上都来院子里转一圈",
   "date": "2025-04-10",
   "cluster": "c04",
   "role": "fact"
  },
  "m007": {
   "text": "客栈堂屋中间有个烧柴的火塘，冬天客人晚上都爱围着烤火聊天",
   "date": "2025-05-15",
   "cluster": "c05",
   "role": "fact"
  },
  "m008": {
   "text": "主人在客栈二楼隔出一间小房自己住，窗户正对着后山",
   "date": "2025-06-01",
   "cluster": null,
   "role": "filler"
  },
  "m009": {
   "text": "主人偏头痛发作那天，客人在前台等了半小时，他强撑着办完入住才回屋躺下",
   "date": "2025-06-10",
   "cluster": "c06",
   "role": "episode"
  },
  "m010": {
   "text": "土豆把客人晾在院子里的一只拖鞋叼走了，主人满村子找了半天",
   "date": "2025-07-01",
   "cluster": "c01",
   "role": "episode"
  },
  "m011": {
   "text": "主人的前同事老周，隔三差五发微信劝他回深圳，说职位还给他留着",
   "date": "2025-07-15",
   "cluster": "c07",
   "role": "fact"
  },
  "m012": {
   "text": "主人的手机信号在村里时有时无，要走到院门口才满格",
   "date": "2025-07-21",
   "cluster": null,
   "role": "filler"
  },
  "m013": {
   "text": "有个叫阿凯的摄影师，每年秋天都来客栈住一个月，拍山里的梯田",
   "date": "2025-08-10",
   "cluster": "c08",
   "role": "fact"
  },
  "m014": {
   "text": "杨阿婆送了主人一罐自己腌的酸菜，说客人爱吃可以拿去做小菜",
   "date": "2025-08-27",
   "cluster": "c04",
   "role": "episode"
  },
  "m015": {
   "text": "烘干机一开就跳闸，把后院的灯也带灭了，主人摸黑检查了半个小时",
   "date": "2025-09-05",
   "cluster": "c09",
   "role": "episode"
  },
  "m016": {
   "text": "主人雇了一位叫玉姐的村里人，每天上午来打扫客房",
   "date": "2025-09-09",
   "cluster": null,
   "role": "filler"
  },
  "m017": {
   "text": "手冲壶的壶嘴被客人碰歪了，主人那天早上只能凑合泡了杯茶",
   "date": "2025-09-13",
   "cluster": "c02",
   "role": "episode"
  },
  "m018": {
   "text": "每年雨季主人都会上山捡野生菌，最爱吃的是鸡枞和牛肝菌",
   "date": "2025-10-09",
   "cluster": "c03",
   "role": "fact"
  },
  "m019": {
   "text": "主人早饭常去村口阿梅开的米线店，每次都要加一勺酸菜和辣油",
   "date": "2025-10-10",
   "cluster": "c10",
   "role": "fact"
  },
  "m020": {
   "text": "主人最怕蜈蚣，后院柴堆里常有，每次看到都要叫隔壁阿叔来处理",
   "date": "2025-11-05",
   "cluster": "c11",
   "role": "fact"
  },
  "m021": {
   "text": "火塘的烟熏黑了新刷的墙，主人叹着气又刷了一遍",
   "date": "2025-11-08",
   "cluster": "c05",
   "role": "episode"
  },
  "m022": {
   "text": "主人最近在看一本讲山区建筑的书，睡前翻几页",
   "date": "2025-11-09",
   "cluster": null,
   "role": "filler"
  },
  "m023": {
   "text": "主人有偏头痛，一熬夜或者天气闷就发作，随身口袋里常备着一瓶风油精",
   "date": "2025-11-28",
   "cluster": "c06",
   "role": "fact"
  },
  "m024": {
   "text": "阿凯给主人拍了张院子门口的照片，主人洗出来挂在了前台",
   "date": "2025-12-09",
   "cluster": "c08",
   "role": "episode"
  },
  "m025": {
   "text": "打雷的夜里突然停了电，主人抱着枕头缩在床脚，一直熬到雨停",
   "date": "2025-12-10",
   "cluster": "c12",
   "role": "episode"
  },
  "m026": {
   "text": "土豆被野蜂蜇了鼻子，肿得像颗真土豆，主人心疼地陪了它一晚",
   "date": "2025-12-14",
   "cluster": "c01",
   "role": "episode"
  },
  "m027": {
   "text": "主人把客栈的小黑板换成了新的，每天写一句当天的天气",
   "date": "2025-12-29",
   "cluster": null,
   "role": "filler"
  },
  "m028": {
   "text": "客栈用的是太阳能热水器，阴天水就不热，客人洗澡时常有意见",
   "date": "2026-01-05",
   "cluster": "c13",
   "role": "fact"
  },
  "m029": {
   "text": "杨阿婆嫌主人院子里的花种得太密，自己动手拔掉了一半",
   "date": "2026-01-19",
   "cluster": "c04",
   "role": "episode"
  },
  "m030": {
   "text": "主人晚上常在院子里弹吉他，客人想听就围过来坐，不想听就早点睡",
   "date": "2026-02-09",
   "cluster": "c14",
   "role": "fact"
  },
  "m031": {
   "text": "阿梅的米线涨价了一块钱，主人嘴上念叨着，第二天还是照吃",
   "date": "2026-02-13",
   "cluster": "c10",
   "role": "episode"
  },
  "m032": {
   "text": "主人去年春节在客栈和留下的几位客人一起吃了年夜饭",
   "date": "2026-02-17",
   "cluster": null,
   "role": "filler"
  },
  "m033": {
   "text": "有位客人房里爬进了蜈蚣，主人站在门口不敢进，最后阿叔拿夹子夹走",
   "date": "2026-03-05",
   "cluster": "c11",
   "role": "episode"
  },
  "m034": {
   "text": "面包车在山路上爆了胎，主人带着一车客人在路边等了两小时",
   "date": "2026-03-07",
   "cluster": "c15",
   "role": "episode"
  },
  "m035": {
   "text": "老周来客栈住了三晚，嘴上说度假，半夜还在回工作消息",
   "date": "2026-03-12",
   "cluster": "c07",
   "role": "episode"
  },
  "m036": {
   "text": "阿凯走的那天落下一副三脚架，主人帮他寄到了广州",
   "date": "2026-03-16",
   "cluster": "c08",
   "role": "episode"
  },
  "m037": {
   "text": "主人从小怕打雷，一听到雷声就捂着耳朵缩在被子里，山里的雷雨天又特别多",
   "date": "2026-03-31",
   "cluster": "c12",
   "role": "fact"
  },
  "m038": {
   "text": "主人有次分不清一种野生菌，拍了照去问村里的老人才敢下锅",
   "date": "2026-04-10",
   "cluster": "c03",
   "role": "episode"
  },
  "m039": {
   "text": "主人的爸爸在杭州，每天早上都会往微信里转一篇养生文章，再配一句早安",
   "date": "2026-04-11",
   "cluster": "c16",
   "role": "fact"
  },
  "m040": {
   "text": "主人请住客喝了杯手冲咖啡，客人喝完非要买两包豆子带走",
   "date": "2026-04-12",
   "cluster": "c02",
   "role": "episode"
  },
  "m041": {
   "text": "客栈的床单冬天晾几天都不干，主人咬牙买了台烘干机放在后院",
   "date": "2026-04-13",
   "cluster": "c09",
   "role": "fact"
  },
  "m042": {
   "text": "主人每个月骑车去镇上赶一次集，买些日用品和零食",
   "date": "2026-04-19",
   "cluster": null,
   "role": "filler"
  },
  "m043": {
   "text": "连着三天阴天，太阳能热水器罢工，主人烧了十几壶水送到房间",
   "date": "2026-04-21",
   "cluster": "c13",
   "role": "episode"
  },
  "m044": {
   "text": "主人在火塘边的灰里埋了几个红薯，客人闻着香味都围了过来",
   "date": "2026-05-06",
   "cluster": "c05",
   "role": "episode"
  },
  "m045": {
   "text": "有客人特意带了火腿肠来看土豆，土豆吃完就跟着人家走了半条街",
   "date": "2026-05-12",
   "cluster": "c01",
   "role": "episode"
  },
  "m046": {
   "text": "主人的风油精用完了，村里小卖部没有，托去镇上的客人带回了三瓶",
   "date": "2026-05-18",
   "cluster": "c06",
   "role": "episode"
  },
  "m047": {
   "text": "爸爸转来一篇劝人早睡的文章，主人刚好熬了夜，只好回了个苦笑的表情",
   "date": "2026-05-31",
   "cluster": "c16",
   "role": "episode"
  },
  "m048": {
   "text": "主人不太喝酒，偶尔客人带了自酿的米酒，只抿一小口",
   "date": "2026-06-08",
   "cluster": null,
   "role": "filler"
  },
  "m049": {
   "text": "房东杨阿婆想把租金涨一点，主人去她家喝了两碗茶才谈妥",
   "date": "2026-06-12",
   "cluster": "c04",
   "role": "episode"
  },
  "m050": {
   "text": "米线店那天卖完了，阿梅从自家锅里舀了碗剩的汤米线给主人",
   "date": "2026-06-23",
   "cluster": "c10",
   "role": "episode"
  },
  "m051": {
   "text": "吉他的一根弦半夜突然断了，主人修了半天，第二天还是去镇上买了新的",
   "date": "2026-06-28",
   "cluster": "c14",
   "role": "episode"
  },
  "m052": {
   "text": "主人整理柴堆时看见蜈蚣，吓得扔了火钳，三天没敢靠近后院",
   "date": "2026-07-04",
   "cluster": "c11",
   "role": "episode"
  },
  "m053": {
   "text": "阿凯凌晨四点就出门等日出，回来时鞋上全是泥，让主人帮忙刷",
   "date": "2026-07-08",
   "cluster": "c08",
   "role": "episode"
  },
  "m054": {
   "text": "主人开一辆二手面包车去大理站接客人，车门拉起来老是吱吱响",
   "date": "2026-07-14",
   "cluster": "c15",
   "role": "fact"
  },
  "m055": {
   "text": "有位客人半夜被雷声吓醒来敲主人的门，主人比客人还要慌",
   "date": "2026-07-19",
   "cluster": "c12",
   "role": "episode"
  },
  "m056": {
   "text": "爸爸寄来一箱杭州的藕粉和龙井，主人分给了客人，自己只留了一小包",
   "date": "2026-07-23",
   "cluster": "c16",
   "role": "episode"
  },
  "m057": {
   "text": "主人床头的闹钟是客人落下的，一直没人来取",
   "date": "2026-07-28",
   "cluster": null,
   "role": "filler"
  },
  "m058": {
   "text": "主人请师傅给热水器加了电加热管，从此再没人抱怨洗澡水凉",
   "date": "2026-07-31",
   "cluster": "c13",
   "role": "episode"
  },
  "m059": {
   "text": "爸爸转来的一篇养生文章其实是谣言，主人花了半小时在微信里给他解释",
   "date": "2026-09-14",
   "cluster": "c16",
   "role": "episode"
  },
  "m060": {
   "text": "主人在院墙上刷了一面白墙，打算以后给客人留言用",
   "date": "2026-09-27",
   "cluster": null,
   "role": "filler"
  }
 },
