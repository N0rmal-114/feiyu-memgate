 "memories": {
  "m001": {
   "text": "主人养了一只巴西龟，名叫墩墩，住在阳台的大鱼缸里",
   "date": "2025-01-13",
   "cluster": "c01",
   "role": "fact"
  },
  "m002": {
   "text": "主人的妈妈每天饭后去小区跳广场舞，领舞的是红姨",
   "date": "2025-01-31",
   "cluster": "c02",
   "role": "fact"
  },
  "m003": {
   "text": "主人是小城实验小学的美术老师，教三到五年级的学生",
   "date": "2025-02-10",
   "cluster": null,
   "role": "filler"
  },
  "m004": {
   "text": "主人的爸爸退休后迷上养兰花，窗台上摆了十几盆",
   "date": "2025-02-27",
   "cluster": "c03",
   "role": "fact"
  },
  "m005": {
   "text": "主人和爸妈住在老小区的三楼，自己的房间朝北",
   "date": "2025-03-15",
   "cluster": null,
   "role": "filler"
  },
  "m006": {
   "text": "主人班上有个叫皮皮的男生，上美术课总把颜料抹到衣服上",
   "date": "2025-03-17",
   "cluster": "c04",
   "role": "fact"
  },
  "m007": {
   "text": "主人最爱喝老城区甜姨糖水铺的红豆沙，每次都要少糖",
   "date": "2025-04-13",
   "cluster": "c05",
   "role": "fact"
  },
  "m008": {
   "text": "主人的手机屏幕右下角摔出了一道裂纹，一直没去换",
   "date": "2025-04-28",
   "cluster": null,
   "role": "filler"
  },
  "m009": {
   "text": "主人批作业总低着头，肩颈很僵，买了台按摩仪放在办公室",
   "date": "2025-05-01",
   "cluster": "c06",
   "role": "fact"
  },
  "m010": {
   "text": "主人上下班骑一辆粉色的电动车，她管它叫小粉",
   "date": "2025-05-28",
   "cluster": "c07",
   "role": "fact"
  },
  "m011": {
   "text": "主人最近在追一部讲民国画家的电视剧，每晚看两集",
   "date": "2025-05-31",
   "cluster": null,
   "role": "filler"
  },
  "m012": {
   "text": "主人周末爱画水彩，最爱画老街上的骑楼",
   "date": "2025-06-15",
   "cluster": "c08",
   "role": "fact"
  },
  "m013": {
   "text": "主人很怕看牙，一直固定找小区对面诊所的林医生",
   "date": "2025-07-03",
   "cluster": "c09",
   "role": "fact"
  },
  "m014": {
   "text": "主人每个月发工资后，都会先给爸妈转一笔家用",
   "date": "2025-07-03",
   "cluster": null,
   "role": "filler"
  },
  "m015": {
   "text": "红姨送了主人妈妈一条丝巾，妈妈戴着去买了一星期菜",
   "date": "2025-07-17",
   "cluster": "c02",
   "role": "episode"
  },
  "m016": {
   "text": "主人的妈妈一直张罗着给她相亲，主人嫌烦又不好意思拒绝",
   "date": "2025-07-30",
   "cluster": "c10",
   "role": "fact"
  },
  "m017": {
   "text": "主人在学校旁的文具店买了一套新的勾线笔，用起来很顺手",
   "date": "2025-08-16",
   "cluster": null,
   "role": "filler"
  },
  "m018": {
   "text": "主人睡眠浅，经常半夜醒来，睡前要放一段白噪音才睡得着",
   "date": "2025-08-17",
   "cluster": "c11",
   "role": "fact"
  },
  "m019": {
   "text": "墩墩趁主人换水时爬出鱼缸，躲到了花盆后面，找了半小时",
   "date": "2025-08-24",
   "cluster": "c01",
   "role": "episode"
  },
  "m020": {
   "text": "主人对虾过敏，吃一口就起疹子，从小就不碰",
   "date": "2025-09-13",
   "cluster": "c12",
   "role": "fact"
  },
  "m021": {
   "text": "主人的高中同学阿宁在广州做设计，约好明年来小城玩",
   "date": "2025-09-18",
   "cluster": null,
   "role": "filler"
  },
  "m022": {
   "text": "皮皮画了一幅主人的肖像，把她画成了长头发的巫婆",
   "date": "2025-09-27",
   "cluster": "c04",
   "role": "episode"
  },
  "m023": {
   "text": "爸爸的一盆兰花开了，特意叫主人拍照发给了老家的亲戚",
   "date": "2025-09-29",
   "cluster": "c03",
   "role": "episode"
  },
  "m024": {
   "text": "主人一直没有驾照，今年报了驾校，教练姓董",
   "date": "2025-10-01",
   "cluster": "c13",
   "role": "fact"
  },
  "m025": {
   "text": "甜姨糖水铺把红豆沙从六块涨到八块，主人嘴上嫌贵还是照买",
   "date": "2025-10-18",
   "cluster": "c05",
   "role": "episode"
  },
  "m026": {
   "text": "主人带学生去郊外的茶园写生，有个学生走丢了十分钟",
   "date": "2025-10-21",
   "cluster": null,
   "role": "filler"
  },
  "m027": {
   "text": "主人晕车很严重，坐大巴要提前吃晕车药，还得坐在前排",
   "date": "2025-10-28",
   "cluster": "c14",
   "role": "fact"
  },
  "m028": {
   "text": "主人把按摩仪的充电线落在办公室，周末专门回学校去拿",
   "date": "2025-11-02",
   "cluster": "c06",
   "role": "episode"
  },
  "m029": {
   "text": "小粉在校门口被人碰倒，后视镜掉了，主人用胶带粘了回去",
   "date": "2025-11-23",
   "cluster": "c07",
   "role": "episode"
  },
  "m030": {
   "text": "主人近视三百度，戴一副细框眼镜，镜腿用久了有点松",
   "date": "2025-12-04",
   "cluster": null,
   "role": "filler"
  },
  "m031": {
   "text": "主人画的一幅骑楼被小城文化馆选中，挂在了展板上",
   "date": "2025-12-08",
   "cluster": "c08",
   "role": "episode"
  },
  "m032": {
   "text": "主人智齿发炎肿了半边脸，林医生给开了三天的消炎药",
   "date": "2025-12-23",
   "cluster": "c09",
   "role": "episode"
  },
  "m033": {
   "text": "妈妈跳舞时崴了脚，红姨扶着她一路慢慢走回了家",
   "date": "2025-12-26",
   "cluster": "c02",
   "role": "episode"
  },
  "m034": {
   "text": "妈妈约了个在银行上班的相亲对象，主人借口加班没有去",
   "date": "2025-12-27",
   "cluster": "c10",
   "role": "episode"
  },
  "m035": {
   "text": "主人喜欢喝无糖的乌龙茶，办公室的茶杯是学生送的",
   "date": "2026-01-06",
   "cluster": null,
   "role": "filler"
  },
  "m036": {
   "text": "主人连着三晚失眠，凌晨三点就醒，白天上课直打哈欠",
   "date": "2026-01-11",
   "cluster": "c11",
   "role": "episode"
  },
  "m037": {
   "text": "同事聚餐端上白灼虾，主人只能喝汤，脖子上还是起了几个红点",
   "date": "2026-02-01",
   "cluster": "c12",
   "role": "episode"
  },
  "m038": {
   "text": "主人在小城新开的商场看了一场动画电影，哭得有点丢人",
   "date": "2026-02-08",
   "cluster": null,
   "role": "filler"
  },
  "m039": {
   "text": "驾校练倒库那天，主人压了线，董教练在旁边叹了口气",
   "date": "2026-02-16",
   "cluster": "c13",
   "role": "episode"
  },
  "m040": {
   "text": "主人坐大巴去省城参加培训，晕车吐了两次，到了脸都是白的",
   "date": "2026-03-09",
   "cluster": "c14",
   "role": "episode"
  },
  "m041": {
   "text": "主人总忘记银行卡的密码，已经去柜台重置过两次",
   "date": "2026-03-24",
   "cluster": null,
   "role": "filler"
  },
  "m042": {
   "text": "主人给墩墩买了块晒背的平台，墩墩第一天就趴上去不肯下来",
   "date": "2026-04-01",
   "cluster": "c01",
   "role": "episode"
  },
  "m043": {
   "text": "主人拿抹布时碰倒一盆兰花，被爸爸念叨了整整一晚上",
   "date": "2026-04-05",
   "cluster": "c03",
   "role": "episode"
  },
  "m044": {
   "text": "皮皮的妈妈来学校道歉，还带了一袋橘子放在主人桌上",
   "date": "2026-04-14",
   "cluster": "c04",
   "role": "episode"
  },
  "m045": {
   "text": "甜姨送了主人一碗刚出的杨枝甘露，请她帮忙试试味道",
   "date": "2026-04-26",
   "cluster": "c05",
   "role": "episode"
  },
  "m046": {
   "text": "学校的刘校长开会爱拖堂，主人经常憋着不敢去洗手间",
   "date": "2026-04-26",
   "cluster": null,
   "role": "filler"
  },
  "m047": {
   "text": "同事借走按摩仪用了一次，直说舒服，主人让她自己买一台",
   "date": "2026-05-05",
   "cluster": "c06",
   "role": "episode"
  },
  "m048": {
   "text": "主人在街边画骑楼，被路过的大爷围观，还被指点了屋檐的画法",
   "date": "2026-05-09",
   "cluster": "c08",
   "role": "episode"
  },
  "m049": {
   "text": "小粉半路没电，主人推着它走了两公里去修车铺充电",
   "date": "2026-05-17",
   "cluster": "c07",
   "role": "episode"
  },
  "m050": {
   "text": "林医生给主人补了颗蛀牙，麻药没过就吃东西，咬破了嘴唇",
   "date": "2026-05-18",
   "cluster": "c09",
   "role": "episode"
  },
  "m051": {
   "text": "广场舞队要参加社区比赛，主人帮阿姨们画了队服上的图案",
   "date": "2026-05-20",
   "cluster": "c02",
   "role": "episode"
  },
  "m052": {
   "text": "主人和一位姓韩的相亲对象喝了杯奶茶，聊的全是各自的工作",
   "date": "2026-05-30",
   "cluster": "c10",
   "role": "episode"
  },
  "m053": {
   "text": "妈妈煮了酸枣仁汤，主人喝完还是醒了两次，只好又开了白噪音",
   "date": "2026-06-08",
   "cluster": "c11",
   "role": "episode"
  },
  "m054": {
   "text": "主人报名了市里青年教师的公开课比赛，准备讲剪纸",
   "date": "2026-06-09",
   "cluster": null,
   "role": "filler"
  },
  "m055": {
   "text": "主人误吃了一个虾饺，赶紧吃了抗过敏药，在家躺了大半天",
   "date": "2026-06-20",
   "cluster": "c12",
   "role": "episode"
  },
  "m056": {
   "text": "主人买了晕车贴贴在耳后，到站时还是觉得头晕想吐",
   "date": "2026-06-24",
   "cluster": "c14",
   "role": "episode"
  },
  "m057": {
   "text": "主人在驾校约不到科目三的考试名额，只好排到下个月",
   "date": "2026-06-29",
   "cluster": "c13",
   "role": "episode"
  },
  "m058": {
   "text": "主人的口红只用一个色号，用完就直接买同款",
   "date": "2026-07-12",
   "cluster": null,
   "role": "filler"
  },
  "m059": {
   "text": "主人睡前爱看半小时漫画，近来在看一部讲厨师的",
   "date": "2026-08-14",
   "cluster": null,
   "role": "filler"
  },
  "m060": {
   "text": "主人家的路由器放在客厅，视频总卡，爸爸坚持不肯换",
   "date": "2026-09-27",
   "cluster": null,
   "role": "filler"
  }
 },
