 "memories": {
  "m001": {
   "text": "主人有一根用了十年的碳素钓竿，亲切地叫它老黑",
   "date": "2025-01-13",
   "cluster": "c01",
   "role": "fact"
  },
  "m002": {
   "text": "主人最常去的钓点是东湾水库，坐公交要一个半小时",
   "date": "2025-01-31",
   "cluster": "c02",
   "role": "fact"
  },
  "m003": {
   "text": "主人今年六十三岁，退休三年，和老伴住在市里的老小区",
   "date": "2025-02-10",
   "cluster": null,
   "role": "filler"
  },
  "m004": {
   "text": "主人钓回来的鲫鱼，老伴最爱做成酸菜鲫鱼汤",
   "date": "2025-02-27",
   "cluster": "c03",
   "role": "fact"
  },
  "m005": {
   "text": "主人和老伴的女儿在外地工作，每年回家两次",
   "date": "2025-03-15",
   "cluster": null,
   "role": "filler"
  },
  "m006": {
   "text": "老伴爱种月季，阳台上摆了二十多盆，天天浇水修枝",
   "date": "2025-03-17",
   "cluster": "c04",
   "role": "fact"
  },
  "m007": {
   "text": "主人当了二十八年铁路调度员，最后几年在城西编组站",
   "date": "2025-04-13",
   "cluster": "c05",
   "role": "fact"
  },
  "m008": {
   "text": "主人喜欢喝浓茶，退休后保温杯从不离手",
   "date": "2025-04-28",
   "cluster": null,
   "role": "filler"
  },
  "m009": {
   "text": "主人血压偏高，每天早上吃一粒降压药，由老伴分好放在药盒里",
   "date": "2025-05-01",
   "cluster": "c06",
   "role": "fact"
  },
  "m010": {
   "text": "主人的孙子叫小宝，五岁，每周日会被送来爷爷奶奶家玩",
   "date": "2025-05-28",
   "cluster": "c07",
   "role": "fact"
  },
  "m011": {
   "text": "主人养成了早睡早起的习惯，天不亮就醒",
   "date": "2025-05-31",
   "cluster": null,
   "role": "filler"
  },
  "m012": {
   "text": "主人每天下午去小区凉亭下象棋，对手是退休教师老顾",
   "date": "2025-06-15",
   "cluster": "c08",
   "role": "fact"
  },
  "m013": {
   "text": "主人腰椎不好，钓鱼时要戴着腰托，坐久了还是会疼",
   "date": "2025-07-03",
   "cluster": "c09",
   "role": "fact"
  },
  "m014": {
   "text": "主人的老花镜度数又加深了，看报纸要拿远点",
   "date": "2025-07-03",
   "cluster": null,
   "role": "filler"
  },
  "m015": {
   "text": "主人爱听京剧，每晚饭后要听半小时《空城计》",
   "date": "2025-07-30",
   "cluster": "c10",
   "role": "fact"
  },
  "m016": {
   "text": "主人每周三陪老伴去超市采购，负责拎东西",
   "date": "2025-08-16",
   "cluster": null,
   "role": "filler"
  },
  "m017": {
   "text": "主人每天早上去菜市场买豆腐脑，摊主是胖婶，总多加一勺糖",
   "date": "2025-08-17",
   "cluster": "c11",
   "role": "fact"
  },
  "m018": {
   "text": "老黑的第二节在河边被人踩断了，主人心疼得一晚没睡好",
   "date": "2025-08-24",
   "cluster": "c01",
   "role": "episode"
  },
  "m019": {
   "text": "东湾水库放水，水位低了一大截，主人坐了一天空手回来",
   "date": "2025-09-08",
   "cluster": "c02",
   "role": "episode"
  },
  "m020": {
   "text": "楼下邻居养了一条黑色的大狗，叫乌云，老伴很怕它",
   "date": "2025-09-13",
   "cluster": "c12",
   "role": "fact"
  },
  "m021": {
   "text": "主人在小区门口的修鞋摊补过一次皮鞋，花了十块钱",
   "date": "2025-09-18",
   "cluster": null,
   "role": "filler"
  },
  "m022": {
   "text": "月季长了蚜虫，老伴蹲在阳台喷了一上午药",
   "date": "2025-09-27",
   "cluster": "c04",
   "role": "episode"
  },
  "m023": {
   "text": "老伴嫌今天的鲫鱼刺多，改做了鱼丸，主人吃了两大碗",
   "date": "2025-09-29",
   "cluster": "c03",
   "role": "episode"
  },
  "m024": {
   "text": "主人每月十五号去老街的理发店剃头，师傅叫小马",
   "date": "2025-10-01",
   "cluster": "c13",
   "role": "fact"
  },
  "m025": {
   "text": "小宝想学钓鱼，主人给他削了根小竹竿，结果钓上来一只拖鞋",
   "date": "2025-10-11",
   "cluster": "c07",
   "role": "episode"
  },
  "m026": {
   "text": "主人在街上听见火车鸣笛，想起在编组站值夜班的日子",
   "date": "2025-10-18",
   "cluster": "c05",
   "role": "episode"
  },
  "m027": {
   "text": "主人的社保卡被老伴收在抽屉里，每次看病才拿出来",
   "date": "2025-10-21",
   "cluster": null,
   "role": "filler"
  },
  "m028": {
   "text": "主人睡觉爱打呼噜，老伴被吵得睡不好，为此分房睡过一阵",
   "date": "2025-10-28",
   "cluster": "c14",
   "role": "fact"
  },
  "m029": {
   "text": "主人忘了吃降压药，头晕得在椅子上坐了半小时才缓过来",
   "date": "2025-11-02",
   "cluster": "c06",
   "role": "episode"
  },
  "m030": {
   "text": "主人最近学会用手机看天气预报，说比电视台准",
   "date": "2025-12-04",
   "cluster": null,
   "role": "filler"
  },
  "m031": {
   "text": "老顾悔棋被主人当场抓住，两人在凉亭里吵了半天",
   "date": "2025-12-08",
   "cluster": "c08",
   "role": "episode"
  },
  "m032": {
   "text": "主人没戴腰托在河边坐了三小时，起身时腰卡住，被路人扶了一把",
   "date": "2025-12-23",
   "cluster": "c09",
   "role": "episode"
  },
  "m033": {
   "text": "小区联欢会上主人唱了一段京剧，跑调了被老伴笑了一周",
   "date": "2025-12-27",
   "cluster": "c10",
   "role": "episode"
  },
  "m034": {
   "text": "主人年轻时在铁路职工运动会上拿过跳远第三名",
   "date": "2026-01-06",
   "cluster": null,
   "role": "filler"
  },
  "m035": {
   "text": "胖婶的豆腐脑涨了五毛，主人嘀咕了一路",
   "date": "2026-01-11",
   "cluster": "c11",
   "role": "episode"
  },
  "m036": {
   "text": "乌云挣脱了绳子冲进楼道，老伴吓得躲进了电梯",
   "date": "2026-02-01",
   "cluster": "c12",
   "role": "episode"
  },
  "m037": {
   "text": "主人家的老电视是十年前买的，换台要拍一下才行",
   "date": "2026-02-08",
   "cluster": null,
   "role": "filler"
  },
  "m038": {
   "text": "小马给主人剃头时聊起儿子考上了大学，主人也跟着高兴",
   "date": "2026-02-16",
   "cluster": "c13",
   "role": "episode"
  },
  "m039": {
   "text": "小宝换牙掉了门牙，趁主人不注意把牙塞进了鱼饵盒",
   "date": "2026-02-21",
   "cluster": "c07",
   "role": "episode"
  },
  "m040": {
   "text": "老伴给主人贴了止鼾贴，说打呼噜的声音小了一半",
   "date": "2026-03-09",
   "cluster": "c14",
   "role": "episode"
  },
  "m041": {
   "text": "主人前年摔过一跤，膝盖青了一个月",
   "date": "2026-03-24",
   "cluster": null,
   "role": "filler"
  },
  "m042": {
   "text": "主人花了六十块让修竿师傅接好老黑，说比买新的划算",
   "date": "2026-04-01",
   "cluster": "c01",
   "role": "episode"
  },
  "m043": {
   "text": "主人把钓到的八条鲫鱼分给邻居，邻居回送了一袋青菜",
   "date": "2026-04-05",
   "cluster": "c03",
   "role": "episode"
  },
  "m044": {
   "text": "主人在东湾遇到一位同样退休的老铁路，聊了一下午",
   "date": "2026-04-10",
   "cluster": "c02",
   "role": "episode"
  },
  "m045": {
   "text": "阳台的月季开了第一朵，老伴拍了照发给在外地的女儿",
   "date": "2026-04-14",
   "cluster": "c04",
   "role": "episode"
  },
  "m046": {
   "text": "主人梦见自己又在调度室里排车，醒来发现才凌晨三点",
   "date": "2026-04-26",
   "cluster": "c05",
   "role": "episode"
  },
  "m047": {
   "text": "主人不爱吃甜食，每次老伴买蛋糕他只尝一口",
   "date": "2026-04-26",
   "cluster": null,
   "role": "filler"
  },
  "m048": {
   "text": "医生把主人的降压药换了一种，说副作用会小一些",
   "date": "2026-05-05",
   "cluster": "c06",
   "role": "episode"
  },
  "m049": {
   "text": "主人连输老顾三盘，回家后一整晚话都不多",
   "date": "2026-05-09",
   "cluster": "c08",
   "role": "episode"
  },
  "m050": {
   "text": "老伴给主人的腰托缝了一层棉垫，说这样不硌",
   "date": "2026-05-18",
   "cluster": "c09",
   "role": "episode"
  },
  "m051": {
   "text": "主人去戏园子听了场京剧，坐在第三排，听着听着睡着了",
   "date": "2026-05-30",
   "cluster": "c10",
   "role": "episode"
  },
  "m052": {
   "text": "胖婶今天没出摊，主人转了半条街才吃上包子",
   "date": "2026-06-08",
   "cluster": "c11",
   "role": "episode"
  },
  "m053": {
   "text": "老伴爱追电视剧，主人陪着看了一整部家庭伦理剧",
   "date": "2026-06-09",
   "cluster": null,
   "role": "filler"
  },
  "m054": {
   "text": "小宝把遥控器藏进了米缸，全家翻了一个多小时才找到",
   "date": "2026-06-16",
   "cluster": "c07",
   "role": "episode"
  },
  "m055": {
   "text": "邻居带着乌云上门道歉，还送了老伴一盒点心",
   "date": "2026-06-20",
   "cluster": "c12",
   "role": "episode"
  },
  "m056": {
   "text": "老伴把主人的呼噜录了下来放给他听，他死活不承认是自己",
   "date": "2026-06-24",
   "cluster": "c14",
   "role": "episode"
  },
  "m057": {
   "text": "理发店涨价到十五块，小马不好意思地解释了半天",
   "date": "2026-06-29",
   "cluster": "c13",
   "role": "episode"
  },
  "m058": {
   "text": "主人每年清明会去给父母扫墓，带一瓶他们爱喝的白酒",
   "date": "2026-07-12",
   "cluster": null,
   "role": "filler"
  },
  "m059": {
   "text": "小区的物业姓贾，每次修水管都说下午来，下午也不来",
   "date": "2026-08-14",
   "cluster": null,
   "role": "filler"
  },
  "m060": {
   "text": "主人打算过年给自己买一双防滑的新胶鞋",
   "date": "2026-09-27",
   "cluster": null,
   "role": "filler"
  }
 },
