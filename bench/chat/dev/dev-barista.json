 "memories": {
  "m001": {
   "text": "主人在出租屋里养了一只金丝熊仓鼠，名叫团长",
   "date": "2025-01-13",
   "cluster": "c01",
   "role": "fact"
  },
  "m002": {
   "text": "主人送外卖时摔过车，左膝落下旧伤，阴雨天会隐隐发酸",
   "date": "2025-01-31",
   "cluster": "c02",
   "role": "fact"
  },
  "m003": {
   "text": "主人二十六岁，老家在外省县城，来省会打工已经四年",
   "date": "2025-02-10",
   "cluster": null,
   "role": "filler"
  },
  "m004": {
   "text": "主人送外卖时的老同事叫阿杰，大家都喊他杰哥，两人还常联系",
   "date": "2025-02-27",
   "cluster": "c03",
   "role": "fact"
  },
  "m005": {
   "text": "主人之前送了两年外卖，去年转行进了咖啡馆当学徒",
   "date": "2025-03-13",
   "cluster": null,
   "role": "filler"
  },
  "m006": {
   "text": "主人练拉花已经三个月，最拿手的是爱心，天鹅还拉不成形",
   "date": "2025-03-17",
   "cluster": "c04",
   "role": "fact"
  },
  "m007": {
   "text": "主人下班后爱喝一罐冰可乐，说比咖啡更解乏",
   "date": "2025-04-13",
   "cluster": "c05",
   "role": "fact"
  },
  "m008": {
   "text": "主人手机屏保是老家的一条黄狗，已经十一岁了",
   "date": "2025-04-24",
   "cluster": null,
   "role": "filler"
  },
  "m009": {
   "text": "主人租的单间，房东姓石，主人叫他石叔，每月五号来收租",
   "date": "2025-05-01",
   "cluster": "c06",
   "role": "fact"
  },
  "m010": {
   "text": "主人的地铁卡是张旧卡，余额总是不够，刷到一半被拦住",
   "date": "2025-05-25",
   "cluster": null,
   "role": "filler"
  },
  "m011": {
   "text": "主人出租屋的窗框漏风，一下雨就渗水，他贴了胶条",
   "date": "2025-05-28",
   "cluster": "c07",
   "role": "fact"
  },
  "m012": {
   "text": "主人有一把二手吉他，自学了半年，只会弹几个和弦",
   "date": "2025-06-15",
   "cluster": "c08",
   "role": "fact"
  },
  "m013": {
   "text": "主人最近在追一个做家常菜的短视频博主",
   "date": "2025-06-25",
   "cluster": null,
   "role": "filler"
  },
  "m014": {
   "text": "主人的妈妈在老家县城开小卖部，每晚九点和他视频",
   "date": "2025-07-03",
   "cluster": "c09",
   "role": "fact"
  },
  "m015": {
   "text": "主人最爱吃楼下的兰州拉面，老板总是多给一勺辣子",
   "date": "2025-07-30",
   "cluster": "c10",
   "role": "fact"
  },
  "m016": {
   "text": "主人讨厌香菜，点什么都要交代一遍不要香菜",
   "date": "2025-08-06",
   "cluster": null,
   "role": "filler"
  },
  "m017": {
   "text": "主人早班五点半起床，闹钟要响三遍才醒得过来",
   "date": "2025-08-17",
   "cluster": "c11",
   "role": "fact"
  },
  "m018": {
   "text": "团长半夜在跑轮上狂奔，吱呀声吵得主人睡不着",
   "date": "2025-08-24",
   "cluster": "c01",
   "role": "episode"
  },
  "m019": {
   "text": "主人上个月打篮球扭了手腕，贴了一周膏药",
   "date": "2025-09-06",
   "cluster": null,
   "role": "filler"
  },
  "m020": {
   "text": "主人站了一整天吧台，左膝疼得上楼梯要扶着扶手",
   "date": "2025-09-08",
   "cluster": "c02",
   "role": "episode"
  },
  "m021": {
   "text": "主人是球鞋爱好者，有一双白色的球鞋一直舍不得穿",
   "date": "2025-09-13",
   "cluster": "c12",
   "role": "fact"
  },
  "m022": {
   "text": "主人拉花拉的爱心被顾客拍了照发朋友圈，他偷偷截图存了下来",
   "date": "2025-09-27",
   "cluster": "c04",
   "role": "episode"
  },
  "m023": {
   "text": "杰哥约主人吃烧烤，说他又换了个平台，一天要跑二十多单",
   "date": "2025-09-29",
   "cluster": "c03",
   "role": "episode"
  },
  "m024": {
   "text": "主人酒量差，一杯啤酒下肚就脸红，被同事笑过好几次",
   "date": "2025-10-01",
   "cluster": "c13",
   "role": "fact"
  },
  "m025": {
   "text": "主人买过一张彩票，只中了五块钱，到现在没兑",
   "date": "2025-10-07",
   "cluster": null,
   "role": "filler"
  },
  "m026": {
   "text": "主人决心戒可乐，坚持了七天，第八天喝了一罐觉得格外好喝",
   "date": "2025-10-18",
   "cluster": "c05",
   "role": "episode"
  },
  "m027": {
   "text": "主人想攒钱开一辆自己的咖啡车，已经存了一年多",
   "date": "2025-10-28",
   "cluster": "c14",
   "role": "fact"
  },
  "m028": {
   "text": "石叔来检查热水器，顺便抱怨主人阳台的衣服晾得太乱",
   "date": "2025-11-02",
   "cluster": "c06",
   "role": "episode"
  },
  "m029": {
   "text": "主人喜欢在地铁上刷短视频，常常坐过站",
   "date": "2025-11-18",
   "cluster": null,
   "role": "filler"
  },
  "m030": {
   "text": "下大雨时窗台积了一滩水，主人拿毛巾堵了半夜",
   "date": "2025-11-23",
   "cluster": "c07",
   "role": "episode"
  },
  "m031": {
   "text": "主人在天台练吉他，邻居上来敲门说太晚了",
   "date": "2025-12-08",
   "cluster": "c08",
   "role": "episode"
  },
  "m032": {
   "text": "同事想给主人介绍女朋友，主人说等攒够钱再说",
   "date": "2025-12-19",
   "cluster": null,
   "role": "filler"
  },
  "m033": {
   "text": "妈妈在视频里叫主人回家吃饭，说小卖部生意不太好",
   "date": "2025-12-23",
   "cluster": "c09",
   "role": "episode"
  },
  "m034": {
   "text": "楼下拉面店涨价了，主人嘴上抱怨，每周还是去三次",
   "date": "2025-12-27",
   "cluster": "c10",
   "role": "episode"
  },
  "m035": {
   "text": "闹钟没响，主人迟到二十分钟，被店长扣了二十块",
   "date": "2026-01-11",
   "cluster": "c11",
   "role": "episode"
  },
  "m036": {
   "text": "主人后背有一块胎记，从来不在同事面前脱外套",
   "date": "2026-01-19",
   "cluster": null,
   "role": "filler"
  },
  "m037": {
   "text": "路上有人踩了主人的球鞋，他当场蹲下来擦了十分钟",
   "date": "2026-02-01",
   "cluster": "c12",
   "role": "episode"
  },
  "m038": {
   "text": "同事聚会上主人喝了半杯啤酒就脸红，被起哄了半天",
   "date": "2026-02-16",
   "cluster": "c13",
   "role": "episode"
  },
  "m039": {
   "text": "主人路过健身房被推销办卡，站在门口犹豫了十分钟没办",
   "date": "2026-03-02",
   "cluster": null,
   "role": "filler"
  },
  "m040": {
   "text": "主人去看了一辆二手咖啡车，车主要价太高，他没买",
   "date": "2026-03-09",
   "cluster": "c14",
   "role": "episode"
  },
  "m041": {
   "text": "团长从笼子里逃了出来，主人在床底下找到它，两颊塞满了瓜子",
   "date": "2026-04-01",
   "cluster": "c01",
   "role": "episode"
  },
  "m042": {
   "text": "主人的身份证快到期了，打算过年回老家换",
   "date": "2026-04-02",
   "cluster": null,
   "role": "filler"
  },
  "m043": {
   "text": "杰哥骑车摔伤了腿，主人拎着一袋水果去出租屋看他",
   "date": "2026-04-05",
   "cluster": "c03",
   "role": "episode"
  },
  "m044": {
   "text": "主人去理疗店针灸了一次，医生说是旧伤加劳损，让他少站",
   "date": "2026-04-10",
   "cluster": "c02",
   "role": "episode"
  },
  "m045": {
   "text": "主人一周练拉花用掉三箱牛奶，被店长委婉地说了一顿",
   "date": "2026-04-14",
   "cluster": "c04",
   "role": "episode"
  },
  "m046": {
   "text": "主人囤在冰箱里的一箱可乐被来串门的朋友喝掉了一半",
   "date": "2026-04-26",
   "cluster": "c05",
   "role": "episode"
  },
  "m047": {
   "text": "石叔说下个月起房租要涨一百块，主人在考虑要不要搬家",
   "date": "2026-05-05",
   "cluster": "c06",
   "role": "episode"
  },
  "m048": {
   "text": "主人给吉他换了新琴弦，音准一下子好了很多",
   "date": "2026-05-09",
   "cluster": "c08",
   "role": "episode"
  },
  "m049": {
   "text": "主人很怕坐过山车，被同事拉去游乐园时只肯在下面拍照",
   "date": "2026-05-14",
   "cluster": null,
   "role": "filler"
  },
  "m050": {
   "text": "主人买了密封胶把窗框重新打了一圈，当晚下雨居然没漏",
   "date": "2026-05-17",
   "cluster": "c07",
   "role": "episode"
  },
  "m051": {
   "text": "妈妈在小卖部里拿着主人买的新电饭煲，对着视频笑得合不拢嘴",
   "date": "2026-05-18",
   "cluster": "c09",
   "role": "episode"
  },
  "m052": {
   "text": "拉面店老板多送了主人一个卤蛋，说看他最近瘦了",
   "date": "2026-05-30",
   "cluster": "c10",
   "role": "episode"
  },
  "m053": {
   "text": "主人买了个会满屋跑的闹钟，第二天追着它跑了半个房间",
   "date": "2026-06-08",
   "cluster": "c11",
   "role": "episode"
  },
  "m054": {
   "text": "主人的蓝牙耳机丢了一只，剩下的一只还在用",
   "date": "2026-06-14",
   "cluster": null,
   "role": "filler"
  },
  "m055": {
   "text": "主人在二手平台卖掉一双球鞋，换回了一台二手磨豆机",
   "date": "2026-06-20",
   "cluster": "c12",
   "role": "episode"
  },
  "m056": {
   "text": "主人每月把三成工资存进专门的卡，攒咖啡车的钱已经有一万多",
   "date": "2026-06-24",
   "cluster": "c14",
   "role": "episode"
  },
  "m057": {
   "text": "主人在便利店买啤酒，被店员查了身份证，说他看着像高中生",
   "date": "2026-06-29",
   "cluster": "c13",
   "role": "episode"
  },
  "m058": {
   "text": "主人在二手市场买了台旧显示器，三十块钱还送了线",
   "date": "2026-07-15",
   "cluster": null,
   "role": "filler"
  },
  "m059": {
   "text": "店里的同事小琳爱吃辣，每次点餐都要特辣",
   "date": "2026-08-26",
   "cluster": null,
   "role": "filler"
  },
  "m060": {
   "text": "主人的黑色工作围裙洗得太多，已经褪成了灰色",
   "date": "2026-09-26",
   "cluster": null,
   "role": "filler"
  }
 },
